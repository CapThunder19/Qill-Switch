# Copy to .env (never commit .env). Private keys live OUTSIDE the repo; point to them by path.

# --- Network (qorechain-diana testnet) ---
QORE_CHAIN_ID=qorechain-diana
QORE_EVM_CHAIN_ID=9800
QORE_EVM_RPC=https://evm-testnet.qore.host
QORE_REST=https://api-testnet.qore.host
QORE_RPC=https://rpc-testnet.qore.host

# --- Key files (absolute paths outside the repo) ---
QILL_KEY_DIR=                    # default ~/.qill/keys ; gen-keys refuses a path inside the repo
OWNER_MLDSA_KEY_FILE=            # owner ML-DSA-87 secret key (offline machine ideally)
GUARDIAN_MLDSA_KEY_FILE=         # guardian ML-DSA-87 secret key
RELAYER_KEY_FILE=                # relayer eth_secp256k1 key + its ML-DSA key
AGENT_ECDSA_KEY_FILE=            # agent linked key (secp256k1)

# --- Deployed addresses ---
VAULT_ADDRESS=
SMART_ACCOUNT_ADDRESS=
POOL_ADDRESS=
TOKEN_A_ADDRESS=
TOKEN_B_ADDRESS=

# --- LLM providers (agent / compiler / guardian use different ones) ---
AGENT_LLM_PROVIDER=anthropic
AGENT_LLM_MODEL=
AGENT_LLM_API_KEY=
GUARDIAN_LLM_PROVIDER=
GUARDIAN_LLM_MODEL=
GUARDIAN_LLM_API_KEY=
