# Copy to .env at the repo root (.env is gitignored; never commit it).
# Every Qill Switch command loads it automatically. Comments must be on their own lines.
# Private keys never go here: they live in QILL_KEY_DIR, outside the repo.

# --- AI (optional; without a key the deterministic paths run and LLM steps are skipped) ---
# Google Gemini (free tier works). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Default gemini-3.8-flash; run `pnpm llm:check` to see the models your key can use
GEMINI_MODEL=
# Or Claude instead (used only if GEMINI_API_KEY is empty)
ANTHROPIC_API_KEY=
# Optional per-role overrides: gemini | anthropic | none, and a model per role.
# Example: give the guardian a different model than the agent.
# GUARDIAN_LLM_PROVIDER=
# GUARDIAN_LLM_MODEL=
# AGENT_LLM_MODEL=
# MANDATE_LLM_MODEL=

# --- Keys ---
# Default ~/.qill/keys. Must be outside the repo (commands refuse otherwise).
QILL_KEY_DIR=

# --- Network (qorechain-diana testnet; these are the defaults) ---
QORE_CHAIN_ID=qorechain-diana
QORE_EVM_RPC=https://evm-testnet.qore.host
QORE_REST=https://api-testnet.qore.host

# --- Local services (bind 127.0.0.1) ---
GUARDIAN_PORT=8787
GUARDIAN_URL=http://127.0.0.1:8787
DASHBOARD_API_PORT=8788
# Optional fixed dashboard session token (random on each start if empty)
QILL_DASHBOARD_TOKEN=
