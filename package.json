{
  "name": "qill-switch",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Quantum-signed mandates for AI agents on QoreChain",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:contracts": "pnpm --filter @qill/contracts test",
    "test:gas": "pnpm --filter @qill/contracts test:gas",
    "typecheck": "pnpm -r typecheck",
    "keys:gen": "pnpm --filter @qill/chain exec tsx scripts/gen-keys.ts",
    "chain:status": "pnpm --filter @qill/chain exec tsx scripts/status.ts",
    "chain:bootstrap": "pnpm --filter @qill/chain exec tsx scripts/bootstrap.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "tsx": "^4.19.2",
    "@types/node": "^22.9.0"
  }
}
