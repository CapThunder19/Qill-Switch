{
  "name": "qill-switch",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Quantum-signed mandates for AI agents on QoreChain",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:contracts": "pnpm --filter @qill/contracts test",
    "test:gas": "pnpm --filter @qill/contracts test:gas",
    "typecheck": "pnpm -r typecheck",
    "keys:gen": "pnpm --filter @qill/chain exec tsx scripts/gen-keys.ts",
    "chain:status": "pnpm --filter @qill/chain exec tsx scripts/status.ts",
    "chain:bootstrap": "pnpm --filter @qill/chain exec tsx scripts/bootstrap.ts",
    "chain:deploy": "pnpm --filter @qill/contracts build && pnpm --filter @qill/chain exec tsx scripts/deploy.ts",
    "owner": "pnpm --filter @qill/chain exec tsx scripts/owner-cmd.ts",
    "attack": "pnpm --filter @qill/attack-bot attack",
    "panic": "pnpm --filter @qill/chain exec tsx scripts/panic.ts",
    "drill:normal-tx": "pnpm --filter @qill/chain exec tsx scripts/normal-tx.ts",
    "qill": "pnpm --silent --filter @qill/cli qill",
    "agent": "pnpm --silent --filter @qill/agent agent",
    "guardian": "pnpm --silent --filter @qill/guardian guardian",
    "dashboard:api": "pnpm --silent --filter @qill/dashboard api",
    "dashboard:dev": "pnpm --filter @qill/dashboard dev",
    "dashboard:build": "pnpm --filter @qill/dashboard build"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "tsx": "^4.19.2",
    "@types/node": "^22.9.0"
  }
}
